# FlowForge configuration. Copy to `.env` and fill in what you need.
# Every variable is optional: FlowForge starts without a .env file.

# ── Server ────────────────────────────────────────────────────────────────
# Port of the web UI + API (n8n uses 5678, so both can run side by side).
PORT=5679
# Interface to listen on. 0.0.0.0 = reachable from your phone on the same Wi-Fi.
HOST=0.0.0.0
# Public base URL used for webhook / form URLs and QR codes.
# Empty = auto-detected LAN address, e.g. http://192.168.1.20:5679
# For a Cloudflare quick tunnel, put the https://….trycloudflare.com URL here.
PUBLIC_URL=
# Where the database, binary files and the encryption key are stored (default: ./data).
FLOWFORGE_DATA_DIR=
# How long a login session stays valid, in days.
SESSION_TTL_DAYS=7
# debug | info | warn | error
LOG_LEVEL=info

# ── Integrations (filled in during later phases, see API_SETUP.md) ────────
